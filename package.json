{
  "name": "@phnq/state",
  "version": "1.11.7",
  "description": "State management for React",
  "main": "index.js",
  "scripts": {
    "dist": "tsc",
    "postdist": "rm -rf dist/__tests__ && bun scripts/postdist.ts",
    "prelint": "tsc -b",
    "lint": "biome check src",
    "clean": "rm -rf dist",
    "test": "bun test",
    "release": "bun run clean && bun test && bun run dist && bun publish --cwd dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pgostovic/state.git"
  },
  "keywords": [
    "react",
    "state",
    "state management",
    "async",
    "side-effects",
    "phnq"
  ],
  "author": "Patrick Gostovic",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/pgostovic/state/issues"
  },
  "homepage": "https://github.com/pgostovic/state#readme",
  "dependencies": {
    "@phnq/log": "^1.1.4",
    "fast-deep-equal": "^3.1.3",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@happy-dom/global-registrator": "^21.0.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.0.0",
    "@types/bun": "^1.4.3",
    "@types/node": "^20.8.0",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "process": "^0.11.10",
    "react-dom": "^18.2.0",
    "typescript": "^5"
  }
}
