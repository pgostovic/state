{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "formatter": {
    "lineWidth": 100,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedLabels": "error"
      },
      "suspicious": {
        "noImplicitAnyLet": "error"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "files": {
    "includes": ["**/*"]
  }
}
